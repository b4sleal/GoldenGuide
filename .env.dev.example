# Development (this machine). Copy to .env and fill credentials. Do not commit the populated file.
# Staging and production use their own files: .env.staging.example and .env.prod.example.
# This is the only file the tests and `uv run` read, so keep .env for development.
APP_ENV=development
# Development uses Compose's default project name (goldenguide), so volumes are named goldenguide_*.
# Staging and production set their own COMPOSE_PROJECT_NAME and keep separate data.
# Compose files and profiles for a bare `docker compose up -d --build --remove-orphans`. Any --profile flag
# replaces COMPOSE_PROFILES (it does not add to it). Add auth here for AUTH_MODE=oidc, and use
# embedding-cpu instead of embedding-gpu on a machine without a GPU.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml
COMPOSE_PROFILES=all-dev,embedding-gpu
# The backend serves one public origin: SITE_ORIGIN, OIDC_REDIRECT_URI and ALLOWED_HOSTS must all use it.
# To use another origin (a personal Cloudflare tunnel or a Tailscale address), change all three and the
# redirect URI registered in the Keycloak client (deploy/keycloak/realm.json).
SITE_ORIGIN=http://localhost:8080
AUTH_MODE=disabled
# With AUTH_MODE=disabled, treat requests from this machine as admin (not via the tunnel; requires
# loopback *_BIND_ADDRESS). Lets you load data at http://localhost:8080/docs without signing in.
# Ignored when AUTH_MODE=oidc; the backend refuses to start with it in production.
LOCAL_ADMIN=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Service client endpoints: use Compose names locally, private DNS/IPs on separate hosts.
DB__POSTGRES__HOST=postgres
DB__POSTGRES__PORT=5432
DB__POSTGRES__DATABASE=goldenguide
DB__POSTGRES__USER=admin
DB__POSTGRES__PASSWORD=admin
BLOB_STORAGE__MINIO__HOST=minio
BLOB_STORAGE__MINIO__PORT=9000
BLOB_STORAGE__MINIO__SECURE=false
BLOB_STORAGE__MINIO__ACCESS_KEY=admin
BLOB_STORAGE__MINIO__SECRET_KEY=admin
VECTOR_STORE__QDRANT__HOST=qdrant
VECTOR_STORE__QDRANT__PORT=6333
VECTOR_STORE__QDRANT__HTTPS=false
VECTOR_STORE__QDRANT__API_KEY=qdranttestapikey
CACHE__REDIS__HOST=redis
CACHE__REDIS__PORT=6379
CACHE__REDIS__PASSWORD=admin

# Integration tests (run on the host, so localhost). Values match the Compose services above;
# tests only touch the `_test` database, Redis DB 15 and uniquely named Qdrant collections.
# Unset = tests skip; GOLDENGUIDE_REQUIRE_TEST_SERVICES=1 (CI) turns a skip into a failure.
GOLDENGUIDE_TEST_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/goldenguide_test
REDIS_TEST_URL=redis://:admin@localhost:6379/15
QDRANT_TEST_URL=http://localhost:6333
QDRANT_TEST_API_KEY=qdranttestapikey
GOLDENGUIDE_REQUIRE_TEST_SERVICES=0

LOCAL_EMBEDDING_SERVICE__HOST=local-embedding-gpu
LOCAL_EMBEDDING_SERVICE__PORT=8001
LOCAL_EMBEDDING_SERVICE__API_KEY=embeddingtestapikey
EMBEDDING_RUNTIME=gpu
MODEL_PROVIDER__GEMINI__API_KEY=
MODEL_PROVIDER__OPENAI__API_KEY=

# Browser stays on the frontend origin; Nginx reaches this backend internally or remotely.
BACKEND_ORIGIN=http://backend:8080
FRONTEND_PORT=8080
BACKEND_PORT=8082

# Host publication defaults to loopback. Change the relevant bind address to a private
# interface when serving other machines, and restrict access with firewall/security groups.
DATABASE_BIND_ADDRESS=127.0.0.1
VECTOR_STORE_BIND_ADDRESS=127.0.0.1
OBJECT_STORE_BIND_ADDRESS=127.0.0.1
STATE_STORE_BIND_ADDRESS=127.0.0.1
EMBEDDING_BIND_ADDRESS=127.0.0.1
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
APP_NETWORK_SUBNET=172.30.0.0/24

# Multi-machine setup over Tailscale (profile: tailnet). MACHINE_NAME names this machine on the
# tailnet and labels its logs. TS_AUTHKEY: reusable, tagged key (admin console > Settings > Keys).
# Then publish shared services on this machine's Tailscale IP, and point clients at other machines', e.g.
#   on the observability machine: OBSERVABILITY_BIND_ADDRESS=100.x.y.z
#   on every other machine:       LOKI_PUSH_URL=http://100.x.y.z:3100/loki/api/v1/push
#                                 OTEL_EXPORTER_OTLP_ENDPOINT=http://100.x.y.z:4317
#                                 (run --profile log-shipper there instead of observability)
MACHINE_NAME=pc
TS_AUTHKEY=
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push

# Empty disables trace export in development when observability is on another host/unused.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
CONTAINER_LOG_FORMAT=json

# The auth profile is a local Keycloak test realm; production can use another OIDC provider.
OIDC_DISCOVERY_URL=http://keycloak.localhost:8081/realms/goldenguide/.well-known/openid-configuration
# Client, roles and secret match the bundled realm (deploy/keycloak/realm.json imports the secret).
OIDC_CLIENT_ID=goldenguide-web
OIDC_CLIENT_SECRET=goldenguide-dev-client-secret
OIDC_REDIRECT_URI=http://localhost:8080/api/v1/auth/callback
OIDC_ADMIN_ROLE=goldenguide-admin
OIDC_STUDENT_ROLE=
# The development realm's one sign-in user (deploy/keycloak/realm.json), given KC_TEST_ADMIN_ROLE.
KC_TEST_ADMIN_USERNAME=admin
KC_TEST_ADMIN_PASSWORD=admin
KC_TEST_ADMIN_ROLE=goldenguide-admin
# Keycloak's own console (master realm), not a GoldenGuide user.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=bootstrap
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Machine callers (system.service_clients in configs/base/system_config.yml). Empty = disabled.
# Create with: uv run python -m backend.core.startup.service_key github_actions_nightly
SERVICE_CLIENT__GITHUB_ACTIONS_NIGHTLY__KEY_HASH=
SERVICE_CLIENT__GITHUB_ACTIONS_NIGHTLY__PREVIOUS_KEY_HASH=
# Used only by the tunnel/all profiles; leave empty for local-only development. A personal tunnel needs its
# own token and hostname (never share a token), with its public hostname targeting http://frontend:8080.
TUNNEL_TOKEN=

# Per-container limits; CPU values are logical cores, not a percentage of the whole PC.
# RAM is a hard cap; swap is disabled. Size model budgets for the models you actually load.
SERVICE_CPUS=0.5
SERVICE_MEMORY_LIMIT=512m
BACKEND_CPUS=1.0
BACKEND_MEMORY_LIMIT=1g
PROVISION_CPUS=1.0
PROVISION_MEMORY_LIMIT=1g
EMBEDDING_GPU_CPUS=2.0
EMBEDDING_GPU_MEMORY_LIMIT=4g
EMBEDDING_CPU_CPUS=2.0
EMBEDDING_CPU_MEMORY_LIMIT=4g
EMBEDDING_THREADS=2
VECTOR_STORE_CPUS=1.0
VECTOR_STORE_MEMORY_LIMIT=2g
DATABASE_CPUS=1.0
DATABASE_MEMORY_LIMIT=1g
AUTH_CPUS=1.0
AUTH_MEMORY_LIMIT=1g
UV_CONCURRENT_DOWNLOADS=2
UV_CONCURRENT_INSTALLS=1
UV_CONCURRENT_BUILDS=1
CONTAINER_LOG_MAX_SIZE=10m
