# Staging: a production-style stack for the whole team (QA, staff) behind https://staging.askgoldenguide.ca.
# Copy to .env.staging and fill every blank value. Do not commit the populated file.
#
#   docker compose --env-file .env.staging up -d --build --remove-orphans
#
# On a dedicated staging host, save this file as .env instead and drop the --env-file flag.
# Blank values are required: docker-compose.prod.yml refuses to start while any of them is empty.
# Staging uses its own credentials, API keys, OIDC client and tunnel. Never reuse production's.
# Settings not listed here (ports, bind addresses, resource limits) use the defaults in docker-compose.yml.

# --- Environment -----------------------------------------------------------------------------
# Compose reads this file for substitution and for the containers' env_file; keep it equal to the filename.
ENV_FILE=.env.staging
# Compose prefixes every container, network and volume with this name, so this environment's data
# (for example goldenguide-staging_pg_data) never mixes with another environment on the same machine.
COMPOSE_PROJECT_NAME=goldenguide-staging
# Compose files and profiles used when none are given on the command line. Any --profile flag replaces
# COMPOSE_PROFILES (it does not add to it), so list every profile you want, e.g. on one machine of a split setup.
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.prod.yml
COMPOSE_PROFILES=all,embedding-gpu
# Address range of this environment's Docker network. Only needed when another environment runs on the same
# machine (development uses the default, 172.30.0.0/24): give each environment its own range.
# APP_NETWORK_SUBNET=172.29.0.0/24
APP_ENV=staging
SITE_ORIGIN=https://staging.askgoldenguide.ca
# localhost is the container's own healthcheck; backend and frontend are the Compose service names.
ALLOWED_HOSTS=staging.askgoldenguide.ca,localhost,backend,frontend
AUTH_MODE=oidc
LOCAL_ADMIN=false

# --- Data stores -----------------------------------------------------------------------------
# Compose service names when the stores run on this host; private DNS names or IPs when they do not.
DB__POSTGRES__HOST=postgres
DB__POSTGRES__PORT=5432
DB__POSTGRES__DATABASE=goldenguide
DB__POSTGRES__USER=
DB__POSTGRES__PASSWORD=
BLOB_STORAGE__MINIO__HOST=minio
BLOB_STORAGE__MINIO__PORT=9000
BLOB_STORAGE__MINIO__SECURE=false
BLOB_STORAGE__MINIO__ACCESS_KEY=
BLOB_STORAGE__MINIO__SECRET_KEY=
VECTOR_STORE__QDRANT__HOST=qdrant
VECTOR_STORE__QDRANT__PORT=6333
VECTOR_STORE__QDRANT__HTTPS=false
VECTOR_STORE__QDRANT__API_KEY=
CACHE__REDIS__HOST=redis
CACHE__REDIS__PORT=6379
CACHE__REDIS__PASSWORD=

# --- Models ----------------------------------------------------------------------------------
# Use the same embedding model and runtime as production, or retrieval in staging proves nothing.
LOCAL_EMBEDDING_SERVICE__HOST=local-embedding-gpu
LOCAL_EMBEDDING_SERVICE__PORT=8001
LOCAL_EMBEDDING_SERVICE__API_KEY=
EMBEDDING_RUNTIME=gpu
# Staging-only keys, ideally with a spend cap, so QA load cannot use production's quota.
MODEL_PROVIDER__GEMINI__API_KEY=
MODEL_PROVIDER__OPENAI__API_KEY=

# --- Frontend --------------------------------------------------------------------------------
# Browser stays on the frontend origin; Nginx reaches this backend internally or remotely.
BACKEND_ORIGIN=http://backend:8080

# --- Authentication (OIDC) -------------------------------------------------------------------
# Keycloak for staging (hosted realm: deploy/keycloak/realm.hosted.json), with its own hostname and users.
# KC_HOSTNAME is its public HTTPS address: route it through the staging tunnel to http://keycloak:8081 and
# do not put Cloudflare Access on it (the backend calls it).
KC_HOSTNAME=https://auth-staging.askgoldenguide.ca
OIDC_DISCOVERY_URL=https://auth-staging.askgoldenguide.ca/realms/goldenguide/.well-known/openid-configuration
OIDC_CLIENT_ID=goldenguide-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://staging.askgoldenguide.ca/api/v1/auth/callback
OIDC_ADMIN_ROLE=goldenguide-admin
# The hosted realm has no student role yet; leave this empty until students sign in.
OIDC_STUDENT_ROLE=
# Required by docker-compose.prod.yml for every service in the file, including profiles not run here.
# Keycloak's own console (master realm), not a GoldenGuide user.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
# First GoldenGuide admin, seeded into the hosted realm when it is first imported (empty keycloak_data volume).
# KC_ADMIN_ROLE must equal OIDC_ADMIN_ROLE. Changing these later does not update an existing realm.
KC_ADMIN_USERNAME=
KC_ADMIN_PASSWORD=
KC_ADMIN_ROLE=goldenguide-admin
# Machine callers (system.service_clients in configs/base/system_config.yml). Empty = disabled.
# Create with: uv run python -m backend.core.startup.service_key github_actions_nightly
SERVICE_CLIENT__GITHUB_ACTIONS_NIGHTLY__KEY_HASH=
SERVICE_CLIENT__GITHUB_ACTIONS_NIGHTLY__PREVIOUS_KEY_HASH=

# --- Public access ---------------------------------------------------------------------------
# Token of the goldenguide-staging Cloudflare tunnel. Its public hostname staging.askgoldenguide.ca
# targets http://frontend:8080, and a Cloudflare Access policy limits it to the team.
TUNNEL_TOKEN=

# --- Machines --------------------------------------------------------------------------------
# One host runs everything by default. To split staging across hosts over Tailscale, give each host
# its own env file (ENV_FILE, MACHINE_NAME, COMPOSE_PROFILES with tailnet, TS_AUTHKEY, *_HOST names)
# as in .env.dev.example's Machines section and docs/docker.md#over-tailscale.
# TS_AUTHKEY=

# --- Observability ---------------------------------------------------------------------------
MACHINE_NAME=staging
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
CONTAINER_LOG_FORMAT=json
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
