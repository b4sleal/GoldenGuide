# Development entry point: preserve the public API origin and forward UI/HMR traffic to Vite.
resolver 127.0.0.11 valid=30s ipv6=off;

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    client_max_body_size 2m;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Vite serves generated dependencies under node_modules/.vite (and sometimes .pnpm).
    # Block hidden root paths here; Vite's own filesystem deny rules protect nested source files.
    location ~ ^/\. {
        deny all;
    }

    # Match the runtime proxy: preserve Host, Origin and cookies; never buffer streamed answers.
    location ~ ^/(api/|docs/?$|redoc/?$|openapi\.json$|health/) {
        set $backend_origin "${BACKEND_ORIGIN}";
        proxy_pass $backend_origin$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location / {
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        # React Refresh injects an inline preamble; only development permits it and the HMR socket.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' ws://$http_host wss://$http_host; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header Cache-Control "no-store" always;
        # Resolve on each request so a recreated Vite container does not leave a stale upstream IP.
        set $vite_origin "http://frontend-vite:5173";
        proxy_pass $vite_origin$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }
}
